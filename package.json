{
  "name": "dsh-font-size",
  "version": "0.1.0",
  "description": "Adjust DSH native UI font sizes from General settings",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tikzen/dsh-font-size.git"
  },
  "homepage": "https://github.com/Tikzen/dsh-font-size",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "settings-screenshot.png"],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "check": "node --check lib/index.mjs && node --check lib/client.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6"
  },
  "devDependencies": {
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "@types/react": "~18.3.1"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": { "node": ">=22" }
}
